/*--------------------------------*- C++ -*----------------------------------*\
  K1 toolhead CFD pipeline template (OpenFOAM v2512). placeholders filled by run_case.py
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.05;
        nCellsInCoarsestLevel 50;
    }
    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors @{n_nonorth};
    consistent      @{consistent};
    residualControl
    {
        p               @{res_p};
        U               @{res_U};
        "(k|omega)"     @{res_turb};
    }
}

relaxationFactors
{
    fields    { p @{relax_p}; }
    equations { U @{relax_U}; "(k|omega)" @{relax_turb}; }
}
