deltaT          1;
writeControl    timeStep;
writeInterval   @{write_interval};
purgeWrite      1;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
@{functions}
}
